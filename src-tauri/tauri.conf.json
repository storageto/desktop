{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StorageTo",
  "version": "0.2.16",
  "identifier": "to.storage.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "StorageTo",
        "width": 380,
        "height": 580,
        "x": -1000,
        "y": -1000,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://storage.to https://*.storage.to https://*.r2.cloudflarestorage.com https://*.cloudflare.com; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDQjk0MDM0QjFEODNBRDUKUldUVk90aXhORUM1VEpQS3lRZG5LazZraEVUbFo2a3NPOXBaZVV2NHl6U1Rpd1RRcjFsSWRMVysK",
      "endpoints": [
        "https://github.com/storageto/desktop/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": ["storageto"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": "v1Compatible",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Upload files from your menu bar",
    "longDescription": "StorageTo Desktop lets you quickly upload files to storage.to directly from your menu bar. Drag and drop files, capture screenshots, and get shareable links instantly.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "appPosition": { "x": 130, "y": 150 },
        "applicationFolderPosition": { "x": 380, "y": 150 },
        "windowSize": { "width": 540, "height": 380 }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
